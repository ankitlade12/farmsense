# Use either ES_CLOUD_ID or ES_URL (your Elasticsearch endpoint)
# ES_CLOUD_ID=your_cloud_id_here
ES_URL=https://my-elasticsearch-project-XXXXX.es.us-central1.gcp.elastic.cloud:443
# Kibana URL (for Agent Builder API). Defaults to ES_URL with .es. → .kb. if not set.
KIBANA_URL=https://my-elasticsearch-project-XXXXX.kb.us-central1.gcp.elastic.cloud
ES_API_KEY=your_api_key_here
ALERT_WEBHOOK_URL=https://your-webhook-endpoint.com/alerts
